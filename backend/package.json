{
  "name": "certikus-backend",
  "version": "1.0.0",
  "description": "Backend API de CERTIKUS - Prevalidación documental registral",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && npm run copy-prisma",
    "copy-prisma": "cp -r src/generated dist/generated",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "certikus",
    "legaltech",
    "registral"
  ],
  "author": "CERTIKUS LegalTech S.A.S.",
  "license": "UNLICENSED",
  "type": "commonjs",
  "dependencies": {
    "@google-cloud/storage": "^8.1.0",
    "@google-cloud/vertexai": "^1.10.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "multer": "^2.0.0",
    "pdfkit": "^0.18.0",
    "pg": "^8.13.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^26.5.1",
    "@types/pdfkit": "^0.17.4",
    "prisma": "^7.10.0",
    "tsx": "^4.23.13",
    "typescript": "^5.4.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "bcrypt@6.0.0": true,
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "@google/genai@1.52.0": true,
    "protobufjs@7.6.6": true
  }
}